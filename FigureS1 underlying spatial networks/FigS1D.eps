  451     0 L
  451   451 L
    0   451 L
cp
clip
[1 0 0 -1 0 450] CT
%%EndPageSetup
GS
[0.75 0 0 0.75 0 0] CT
1 GC
N
0 0 600 600 re
f
GR
GS
[0.47974 0 0 0.47974 0 162.15353] CT
[1 0 0 1 0 0] CT
N
0 -338 M
938 -338 L
938 600 L
0 600 L
0 -338 L
cp
clip
GS
0 0 translate
600 600 scale
